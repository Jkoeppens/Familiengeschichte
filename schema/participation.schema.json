{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "participation.schema.json",
  "title": "Participation",
  "description": "Verknüpfung zwischen Akteur und Event (CIDOC-CRM P11/P12/P15)",
  "type": "object",
  "required": ["event_id", "actor_id", "relation", "role", "created_at"],
  "additionalProperties": false,
  "properties": {

    "event_id": {
      "type": "string",
      "pattern": "^event_[a-z0-9_]+$",
      "description": "Referenz auf Event-ID"
    },

    "actor_id": {
      "type": "string",
      "pattern": "^(person|unit|org)_[a-z0-9_]+$",
      "description": "Referenz auf Actor-ID"
    },

    "relation": {
      "type": "string",
      "enum": [
        "had_participant",
        "occurred_in_presence_of",
        "was_influenced_by",
        "perpetrator",
        "victim"
      ],
      "description": "Art der Beteiligung (CIDOC-CRM P11/P12/P15 vereinfacht). Stärke: had_participant > occurred_in_presence_of > was_influenced_by"
    },

    "role": {
      "type": "string",
      "enum": [
        "soldier", "patient", "commander", "prisoner", "victim",
        "witness", "unit", "superior", "subordinate", "allied",
        "opposing", "location", "origin", "destination",
        "joined", "joined_with"
      ],
      "description": "Spezifische Rolle des Akteurs in diesem Event"
    },

    "certainty_override": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 5,
      "description": "Überschreibt Event-Quellenqualität wenn Beteiligung unsicherer ist. Nur setzen wenn nötig."
    },

    "note": {
      "type": ["string", "null"],
      "description": "Begründung der Beteiligung, besonders bei entity_linking"
    },

    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
