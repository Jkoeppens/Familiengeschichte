{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "actor.schema.json",
  "title": "Actor",
  "description": "Person oder Militäreinheit im Familiengeschichte-Datenmodell",
  "type": "object",
  "required": ["id", "type", "pref_label", "alt_labels", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(person|unit|org)_[a-z0-9_]+$",
      "description": "Eindeutige ID, Format: {typ}_{snake_case}, unveränderlich"
    },
    "type": {
      "type": "string",
      "enum": ["Person", "MilitaryUnit", "Organization"],
      "description": "Akteur-Typ"
    },
    "pref_label": {
      "type": "string",
      "minLength": 1,
      "description": "Bevorzugter Name (kanonisch)"
    },
    "alt_labels": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Alternative Namen und Schreibweisen, auch leer []"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Datum des Eintrags, ISO 8601 YYYY-MM-DD"
    },
    "same_as": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "description": "Links zu externen LOD-Ressourcen (Wikidata, GND etc.)"
    },
    "notes": {
      "type": ["string", "null"],
      "description": "Freitext-Notizen"
    },

    "family_name": {
      "type": ["string", "null"],
      "description": "Familienname (nur Person)"
    },
    "given_name": {
      "type": ["string", "null"],
      "description": "Vorname(n) (nur Person)"
    },
    "birth_date": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "description": "Geburtsdatum ISO 8601 (nur Person)"
    },
    "death_date": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "description": "Sterbedatum ISO 8601 (nur Person)"
    },
    "birth_place": {
      "type": ["string", "null"],
      "description": "Geburtsort als Freitext (nur Person)"
    },

    "abbr": {
      "type": ["string", "null"],
      "description": "Abkürzung (nur MilitaryUnit, z.B. N.A. 20)"
    },
    "branch": {
      "type": ["string", "null"],
      "enum": ["Heer", "Luftwaffe", "Kriegsmarine", "Waffen-SS",
               "Ordnungspolizei", "Einsatzgruppe", "Sicherheitsdienst",
               "Unknown", null],
      "description": "Truppengattung (nur MilitaryUnit)"
    },
    "unit_type": {
      "type": ["string", "null"],
      "enum": ["Division", "Regiment", "Bataillon", "Kompanie",
               "Abteilung", "Korps", "Armee", "Heeresgruppe",
               "Sonderverband", "Unknown", null],
      "description": "Einheitstyp (nur MilitaryUnit)"
    },
    "heimatgarnison": {
      "type": ["string", "null"],
      "description": "Heimatgarnison (nur MilitaryUnit)"
    },
    "wehrkreis": {
      "type": ["string", "null"],
      "description": "Wehrkreis als römische Zahl oder Kürzel (nur MilitaryUnit)"
    },
    "parent_unit_id": {
      "type": ["string", "null"],
      "pattern": "^unit_[a-z0-9_]+$",
      "description": "ID der übergeordneten Stammeinheit (nur MilitaryUnit)"
    },
    "tessin_band": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 17,
      "description": "Tessin-Band in dem diese Einheit dokumentiert ist"
    },
    "tessin_seite": {
      "type": ["integer", "null"],
      "description": "Seitennummer in Tessin"
    }
  },

  "allOf": [
    {
      "if": { "properties": { "type": { "const": "Person" } } },
      "then": {
        "required": ["family_name", "given_name"],
        "properties": {
          "branch": { "type": "null" },
          "unit_type": { "type": "null" },
          "heimatgarnison": { "type": "null" },
          "wehrkreis": { "type": "null" },
          "parent_unit_id": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "MilitaryUnit" } } },
      "then": {
        "required": ["branch", "unit_type"],
        "properties": {
          "family_name": { "type": "null" },
          "given_name": { "type": "null" },
          "birth_date": { "type": "null" },
          "death_date": { "type": "null" },
          "birth_place": { "type": "null" }
        }
      }
    }
  ]
}
